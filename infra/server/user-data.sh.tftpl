#!/bin/bash
# First boot of the app server (Amazon Linux 2023, ARM): Docker and Compose,
# swap, the data disk, and a systemd service that starts the app on every
# boot. The app's Compose file and deploy.sh are written by each rollout (see
# the deploy workflow). Rendered by server.tf; changing it replaces the
# instance (the data disk is kept).
set -euo pipefail
exec > >(tee -a /var/log/health-mcp-setup.log) 2>&1

APP_DIR=/srv/health-mcp
DATA_DIR=${data_dir}

# --- Docker and the Compose plugin (checked against its published checksum)
dnf install -y docker
systemctl enable --now docker
COMPOSE_RELEASES=https://github.com/docker/compose/releases/download
COMPOSE_URL=$COMPOSE_RELEASES/${compose_version}/docker-compose-linux-aarch64
mkdir -p /usr/libexec/docker/cli-plugins
curl -fsSL -o /tmp/docker-compose "$COMPOSE_URL"
echo "$(curl -fsSL "$COMPOSE_URL.sha256" | cut -d' ' -f1)  /tmp/docker-compose" | sha256sum -c -
install -m 0755 /tmp/docker-compose /usr/libexec/docker/cli-plugins/docker-compose

# --- Swap: room for peaks above the instance's memory (models loading, Node)
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=${swap_mb}
  chmod 600 /swapfile
  mkswap /swapfile
  echo "/swapfile none swap defaults 0 0" >> /etc/fstab
fi
swapon -a

# --- Data disk (SQLite, imaging): found by its volume id, formatted only when empty
# A new server starts before the old one lets go of the disk (see cdn.tf), so wait for it.
VOLUME_ID=${data_volume_id}
DEVICE=/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$${VOLUME_ID//-/}
for _ in $(seq 1 120); do [ -e "$DEVICE" ] && break; sleep 5; done
[ -e "$DEVICE" ] || { echo "Data volume $VOLUME_ID never appeared"; exit 1; }
blkid "$DEVICE" || mkfs -t xfs "$DEVICE"
mkdir -p "$DATA_DIR"
grep -q "$DATA_DIR" /etc/fstab || echo "$DEVICE $DATA_DIR xfs defaults,nofail 0 2" >> /etc/fstab
mount -a
# The containers run as the node user (uid 1000).
chown 1000:1000 "$DATA_DIR"

# --- The app: the service starts it on every boot, once a rollout has written deploy.sh.
mkdir -p "$APP_DIR"
cat > /etc/systemd/system/health-mcp.service <<'UNIT'
[Unit]
Description=health-mcp (Docker Compose)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
ConditionPathExists=/srv/health-mcp/deploy.sh

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/srv/health-mcp/deploy.sh
ExecStop=/usr/bin/docker compose -f /srv/health-mcp/compose.yml down
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable health-mcp.service
