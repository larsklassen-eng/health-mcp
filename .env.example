# Copy to .env (git-ignored) and fill in. Read by apps/api, apps/mcp-server and packages/db.

# SQLite file, relative to the repo root.
DATABASE_PATH=data/health.db

# apps/api
PORT=3001
WEB_ORIGIN=http://localhost:3000

# Chat (apps/api). The api starts without a key; chat requests then fail. Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5.5
# Only use zero-data-retention providers (data-collecting providers are always excluded).
OPENROUTER_ZDR=true
# Let the provider cache prompts for a few minutes so repeated input costs less.
OPENROUTER_PROMPT_CACHING=true
# Output token cap per model turn; OpenRouter reserves credit for this many tokens per request.
LLM_MAX_TOKENS=16000
# Characters of earlier chat messages sent with each question; older ones are left out.
CHAT_HISTORY_MAX_CHARS=40000

# apps/mcp-server. Listens on localhost only. Without a token it starts but rejects every
# request; generate one with `openssl rand -hex 32`. Never commit a real token.
MCP_PORT=3002
# Shared by apps/mcp-server and apps/api. Without it, chat still works but the model gets no tools.
MCP_AUTH_TOKEN=
# Where apps/api finds the MCP server.
MCP_URL=http://127.0.0.1:3002/mcp

# Sign-in (apps/api). `off` (the default, except with NODE_ENV=production) or `password`:
# users sign in with an email and a password, created with `yarn user add <email>`.
# AUTH_MODE=password
# Signs the session cookies; at least 32 characters (`openssl rand -hex 32`). Changing it
# signs everyone out. Never commit a real one.
SESSION_SECRET=
# SESSION_TTL_HOURS=12

# apps/web (server side only). Next.js reads env from apps/web/.env*, not this file;
# the default works when the api runs locally on port 3001.
# API_URL=http://localhost:3001
