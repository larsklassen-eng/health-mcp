# Copy to .env (git-ignored) and fill in. Read by apps/api and packages/db.

# SQLite file, relative to the repo root.
DATABASE_PATH=data/health.db

# apps/api
PORT=3001
WEB_ORIGIN=http://localhost:3000

# Chat (apps/api). The api starts without a key; chat requests then fail. Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5.5
# Only use zero-data-retention providers (data-collecting providers are always excluded).
OPENROUTER_ZDR=true
# Output token cap per model turn; OpenRouter reserves credit for this many tokens per request.
LLM_MAX_TOKENS=16000

# apps/web (server side only). Next.js reads env from apps/web/.env*, not this file;
# the default works when the api runs locally on port 3001.
# API_URL=http://localhost:3001
