{
  "name": "@health-mcp/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "db:generate": "turbo run build && drizzle-kit generate",
    "db:migrate": "turbo run build && node dist/migrate.js",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@health-mcp/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "sqlite-vec": "^0.1.9"
  }
}
