{
  "name": "@health-mcp/rag",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tracing": {
      "types": "./dist/start-tracing.d.ts",
      "default": "./dist/start-tracing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "rag:model": "turbo run build && node dist/cli/download-model.js",
    "rag:reindex": "turbo run build && node dist/cli/reindex.js"
  },
  "dependencies": {
    "@arizeai/openinference-semantic-conventions": "^2.15.0",
    "@health-mcp/db": "workspace:*",
    "@health-mcp/shared": "workspace:*",
    "@huggingface/transformers": "^4.3.1",
    "@opentelemetry/api": "~1.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.220.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  }
}
