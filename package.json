{
  "name": "health-mcp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "eval": "turbo run build && yarn workspace @health-mcp/evals eval",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "db:generate": "yarn workspace @health-mcp/db db:generate",
    "db:migrate": "yarn workspace @health-mcp/db db:migrate",
    "imaging:synthetic": "yarn workspace @health-mcp/api imaging:synthetic",
    "rag:model": "yarn workspace @health-mcp/rag rag:model",
    "rag:reindex": "yarn workspace @health-mcp/rag rag:reindex"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "packageManager": "yarn@4.18.1"
}
