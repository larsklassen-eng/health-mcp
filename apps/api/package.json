{
  "name": "@health-mcp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc && (tsc --watch --preserveWatchOutput & node --watch-path=dist dist/main.js)",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "imaging:synthetic": "turbo run build && node dist/cli/write-synthetic-dicom.js"
  },
  "dependencies": {
    "@health-mcp/db": "workspace:*",
    "@health-mcp/rag": "workspace:*",
    "@health-mcp/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nestjs/common": "~12.1.2",
    "@nestjs/core": "~12.1.2",
    "@nestjs/platform-express": "~12.1.2",
    "@openrouter/sdk": "^1.4.25",
    "dicom-parser": "^1.8.21",
    "drizzle-orm": "^0.45.3",
    "pngjs": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@swc/core": "^1.16.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  }
}
