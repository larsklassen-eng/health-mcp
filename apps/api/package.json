{
  "name": "@health-mcp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && (tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch-path=dist --env-file-if-exists=../../.env dist/main.js)",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@health-mcp/db": "workspace:*",
    "@health-mcp/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nestjs/common": "~12.1.2",
    "@nestjs/core": "~12.1.2",
    "@nestjs/platform-express": "~12.1.2",
    "@openrouter/sdk": "^1.4.25",
    "drizzle-orm": "^0.45.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@swc/core": "^1.16.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  }
}
