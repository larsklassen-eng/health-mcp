{
  "name": "@health-mcp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && (tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch-path=dist --env-file-if-exists=../../.env dist/main.js)",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@health-mcp/db": "workspace:*",
    "@health-mcp/shared": "workspace:*",
    "@nestjs/common": "~12.1.2",
    "@nestjs/core": "~12.1.2",
    "@nestjs/platform-express": "~12.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
