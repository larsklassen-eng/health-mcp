# dependencies
node_modules/

# yarn 4: keep the pinned release, ignore caches and install state
.yarn/*
!.yarn/releases
!.yarn/patches
!.yarn/plugins
.pnp.*

# build output
dist/
.next/
next-env.d.ts
.turbo/
*.tsbuildinfo

# environment / secrets
.env
.env.*
!.env.example

# local health data: never commit (real or generated)
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# eval reports (yarn eval)
eval-results/

# OS
.DS_Store

# terraform: local working files and state (state lives in S3)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
